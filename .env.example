# Obtain your own API Key at https://writerpro.cn/open-platform.html
# Server only. Never use NEXT_PUBLIC_, VITE_ or a browser-side key.
WRITERPRO_API_KEY=replace_with_your_api_key
WRITERPRO_API_BASE=https://a.writerpro.cn/text-api/v1

# Local use: open http://127.0.0.1:3080
HOST=127.0.0.1
PORT=3080

# Required when listening on a non-loopback address or using a public domain.
# One deployed instance uses ONE API account: visitors share its quota/balance.
# Use a unique password of at least 12 characters. Set HTTPS origin for public hosting.
ACCESS_PASSWORD=
PUBLIC_ORIGIN=
